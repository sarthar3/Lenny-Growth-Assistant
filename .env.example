# ==========================================
# The Lenny Growth Assistant - Configuration
# ==========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# Default PostgreSQL container connection string for Docker Compose
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lenny_growth_db
# Local SQLite fallback option for zero-setup execution:
# DATABASE_URL=sqlite+aiosqlite:///./lenny_growth_assistant.db

# LLM Provider Configuration
# Options: 'groq', 'ollama', 'anthropic', 'openai', 'mock_local'
LLM_PROVIDER=groq

# Groq Cloud Settings (Recommended for ultra-fast, high-quality responses)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama Settings (For Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud LLM Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Knowledge Base & Retrieval
TRANSCRIPT_DIR=./data/transcripts_repo/episodes
TOP_K_RETRIEVAL=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
